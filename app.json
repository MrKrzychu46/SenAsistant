{
  "expo": {
    "name": "Sen - Licznik Kruków",
    "slug": "sen-asistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0d1a",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0d1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sen.asistant"
    },
    "android": {
      "package": "com.sen.asistant",
      "adaptiveIcon": {
        "backgroundColor": "#0a0d1a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0d1a",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "74f25dfb-511d-4e9b-8784-171b119e9b66"
      }
    },
    "owner": "klyszczarz03"
  }
}
